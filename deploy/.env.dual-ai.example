# Copy this file to deploy/.env and replace every CHANGE_ME value.
# deploy/.env is ignored by Git and must never be committed.

OMBRE_BIND_ADDRESS=127.0.0.1
OMBRE_MCP_AUTH_MODE=token

# Model providers may be shared. Memory, configuration, and credentials are not.
OMBRE_COMPRESS_API_KEY=CHANGE_ME
OMBRE_COMPRESS_BASE_URL=
OMBRE_COMPRESS_MODEL=
OMBRE_EMBED_API_KEY=
OMBRE_EMBED_BASE_URL=
OMBRE_EMBED_MODEL=

OMBRE_CLAUDE_PASSWORD=CHANGE_ME
OMBRE_CLAUDE_MCP_TOKEN=CHANGE_ME_USE_A_LONG_RANDOM_TOKEN
OMBRE_GPT_PASSWORD=CHANGE_ME
OMBRE_GPT_MCP_TOKEN=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_TOKEN

# Optional absolute host paths. Leave empty to use data/claude and data/gpt.
OMBRE_CLAUDE_VAULT_DIR=
OMBRE_GPT_VAULT_DIR=
